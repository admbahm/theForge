llm:
  provider: ollama
  model: gemma4:e4b

providers:
  ollama:
    host: http://localhost:11434
    model: gemma4:e4b
  openai:
    api_key_env: OPENAI_API_KEY
    model: gpt-4.1-mini
  gemini:
    api_key_env: GEMINI_API_KEY
    model: gemini-2.5-flash

# Application artifacts fail closed unless a private CKB and candidate identity
# are explicitly configured. Never point production use at the bundled ./ckb examples.
application:
  ckb_dir: /absolute/path/to/your/private/ckb
  demo_mode: false
  contact:
    name: Your Name
    email: you@example.com
    phone: ""
    address: ""
    linkedin: ""
    github: ""
